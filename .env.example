DISCORD_BOT_TOKEN=your-bot-token-here

# Optional: if set, a CSV backup is automatically posted here every Sunday
# at 9am US/Eastern. Create a webhook in your PERSONAL server (Channel
# Settings -> Integrations -> Webhooks -> New Webhook) and paste its URL
# here. The bot does NOT need to be a member of that server for this to
# work. Leave blank/unset to disable automated backups entirely.
BACKUP_WEBHOOK_URL=
